{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "Eve's local store carries a patch for its exact version (runtime/eve-world/README.md): an update has to move the patch with it",
      "matchPackageNames": ["@workflow/world-local"],
      "dependencyDashboardApproval": true
    }
  ]
}
