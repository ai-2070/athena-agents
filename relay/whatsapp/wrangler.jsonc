{
  "name": "athena-whatsapp-relay",
  "main": "worker.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "QUEUE", "class_name": "WhatsAppRelayQueue" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WhatsAppRelayQueue"] }],
  "vars": {
    "BUSINESS_ACCOUNT_ID": "REPLACE_WITH_BUSINESS_ACCOUNT_ID",
    "PHONE_NUMBER_ID": "REPLACE_WITH_PHONE_NUMBER_ID",
    "RETENTION_SECONDS": "259200",
    "MAX_EVENTS": "1000",
    "MAX_BYTES": "16777216",
    "MAX_REPLAY_IDS": "10000"
  }
}
