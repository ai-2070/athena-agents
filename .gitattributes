# The skills that come with the dashboard are copies of other repos, kept byte for byte (some hash their own files):
# LF line endings on every checkout, Windows too.
/skills/** text=auto eol=lf

# bun fmt keeps CRLF in other files (endOfLine = "auto" in bunfig.toml) but not in TOML, so a Windows
# checkout of these would fail the format check.
*.toml text eol=lf
