{
  "name": "athena-agents",
  "version": "1.0.3",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "description": "Run AI agents and teams from one local workspace: a live 3D map, team chats, Claude Code, Codex and local models, MCP tools, Outbox and Artifacts. No account, runs on your computer.",
  "keywords": [
    "ai-agents",
    "multi-agent",
    "agent-orchestration",
    "ai-dashboard",
    "local-first",
    "claude-code",
    "codex",
    "mcp",
    "model-context-protocol",
    "llm",
    "ollama",
    "lm-studio",
    "desktop-app",
    "tauri",
    "bun",
    "typescript",
    "threejs"
  ],
  "homepage": "https://github.com/ai-2070/athena-agents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-2070/athena-agents.git"
  },
  "bugs": {
    "url": "https://github.com/ai-2070/athena-agents/issues"
  },
  "type": "module",
  "main": "server/index.ts",
  "scripts": {
    "start": "bun run eve:build && bun run build && bun server/index.ts",
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build-web.ts",
    "icons": "bun scripts/build-icons.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json && tsc -p runtime/eve/tsconfig.json",
    "eve:build": "bun scripts/build-eve.ts",
    "eve:smoke": "bun scripts/eve-smoke.ts",
    "eve:recovery": "bun scripts/eve-recovery-smoke.ts",
    "eve:integration": "bun scripts/eve-integration-smoke.ts",
    "lint": "biome lint --error-on-warnings",
    "lint:fix": "biome lint --write --error-on-warnings",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:smoke": "bun scripts/desktop-smoke.ts"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=26"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.95",
    "@ai-sdk/react": "4.0.187",
    "@athena/eve-world": "file:./runtime/eve-world",
    "@base-ui/react": "1.9.0",
    "@emoji-mart/data": "1.2.1",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/google-sans": "5.3.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/merriweather": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
    "@lydell/node-pty": "1.2.0-beta.18",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openuidev/react-headless": "0.19.0",
    "@openuidev/react-lang": "1.2.0",
    "@openuidev/react-ui": "0.19.0",
    "@orpc/client": "1.16.6",
    "@orpc/contract": "1.16.6",
    "@orpc/openapi": "1.16.6",
    "@orpc/openapi-client": "1.16.6",
    "@orpc/server": "1.16.6",
    "@orpc/standard-server-fetch": "1.16.6",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-virtual": "3.14.28",
    "@workflow/world-local": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ai": "7.0.179",
    "dompurify": "3.5.0",
    "eve": "1.5.0",
    "fflate": "0.8.3",
    "just-bash": "3.6.1",
    "marked": "18.3.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "unpdf": "2.2.2",
    "ws": "8.23.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@tailwindcss/node": "4.3.5",
    "@tailwindcss/oxide": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@types/bun": "1.4.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.10",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "happy-dom": "21.0.4",
    "jsdom": "31.0.1",
    "lightningcss": "1.33.0",
    "simple-icons": "16.38.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "patchedDependencies": {
    "@workflow/world-local@5.3.0": "patches/@workflow%2Fworld-local@5.3.0.patch"
  }
}
