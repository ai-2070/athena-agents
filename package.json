{
  "name": "blacksite",
  "version": "0.2.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "description": "Local, login-free command center for AI agents, tools, programs, MCP servers and social accounts.",
  "type": "module",
  "main": "server/index.ts",
  "scripts": {
    "start": "bun run build && bun server/index.ts",
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build-web.ts",
    "icons": "bun scripts/build-icons.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run test",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:smoke": "bun scripts/desktop-smoke.ts"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.157",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openuidev/react-headless": "^0.18.1",
    "@openuidev/react-lang": "^1.0.1",
    "@openuidev/react-ui": "^0.18.1",
    "@tanstack/react-virtual": "^3.13.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.153",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "^1.4.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "lucide-static": "^1.0.0",
    "simple-icons": "^16.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
