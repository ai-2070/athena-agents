{
  "name": "athena-agents",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "description": "Run AI agents and teams from one local workspace: a live 3D map, team chats, Claude Code, Codex and local models, MCP tools, Outbox and Artifacts. No account, runs on your computer.",
  "keywords": [
    "ai-agents",
    "multi-agent",
    "agent-orchestration",
    "ai-dashboard",
    "local-first",
    "claude-code",
    "codex",
    "mcp",
    "model-context-protocol",
    "llm",
    "ollama",
    "lm-studio",
    "desktop-app",
    "tauri",
    "bun",
    "typescript",
    "threejs"
  ],
  "homepage": "https://github.com/ai-2070/athena-agents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-2070/athena-agents.git"
  },
  "bugs": {
    "url": "https://github.com/ai-2070/athena-agents/issues"
  },
  "type": "module",
  "main": "server/index.ts",
  "scripts": {
    "start": "bun run eve:build && bun run build && bun server/index.ts",
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build-web.ts",
    "icons": "bun scripts/build-icons.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json && tsc -p runtime/eve/tsconfig.json && tsc -p relay/whatsapp/tsconfig.json",
    "eve:build": "bun scripts/build-eve.ts",
    "eve:smoke": "bun scripts/eve-smoke.ts",
    "eve:recovery": "bun scripts/eve-recovery-smoke.ts",
    "eve:integration": "bun scripts/eve-integration-smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "gateways:smoke": "bun scripts/gateways-smoke.ts",
    "gateways:slack-smoke": "bun scripts/gateways-slack-smoke.ts",
    "gateways:discord-smoke": "bun scripts/gateways-discord-smoke.ts",
    "check": "bun run typecheck && bun run test",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:smoke": "bun scripts/desktop-smoke.ts",
    "relay:build": "bun scripts/build-whatsapp-relay.ts",
    "gateways:whatsapp-relay-smoke": "bun scripts/gateways-whatsapp-relay-smoke.ts",
    "gateways:whatsapp-media-smoke": "bun scripts/gateways-whatsapp-media-smoke.ts"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.85",
    "@ai-sdk/react": "4.0.167",
    "@athena/eve-world": "file:./runtime/eve-world",
    "@base-ui/react": "1.9.0",
    "@chat-adapter/discord": "4.44.0",
    "@chat-adapter/slack": "4.44.0",
    "@chat-adapter/telegram": "4.44.0",
    "@chat-adapter/whatsapp": "4.44.0",
    "@emoji-mart/data": "1.2.1",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/google-sans": "5.3.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/merriweather": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
    "@lydell/node-pty": "1.2.0-beta.18",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openuidev/react-headless": "0.18.1",
    "@openuidev/react-lang": "1.1.0",
    "@openuidev/react-ui": "0.18.1",
    "@phosphor-icons/react": "2.1.10",
    "@slack/socket-mode": "3.1.1",
    "@tanstack/react-virtual": "3.14.26",
    "@workflow/world-local": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ai": "7.0.163",
    "chat": "4.44.0",
    "dompurify": "3.4.17",
    "eve": "1.0.0-rc.2",
    "just-bash": "3.6.0",
    "libphonenumber-js": "1.13.15",
    "marked": "18.1.3",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "ws": "8.22.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@tailwindcss/node": "4.3.4",
    "@tailwindcss/oxide": "4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/bun": "1.4.4",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3",
    "lightningcss": "1.33.0",
    "miniflare": "4.20260730.0",
    "simple-icons": "16.36.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
